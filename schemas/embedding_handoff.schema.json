{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Semantic Embedding Handoff Pack",
  "description": "Portable cognitive state for zero-drag transfer between Continuity Architect sessions and other models/tools. Generated by aegis.continuity.",
  "type": "object",
  "required": [
    "handoff_version",
    "generated_at",
    "session_id",
    "embedding_model",
    "dimensions",
    "distance_metric",
    "integrity_hash",
    "vectors",
    "retrieval_hints"
  ],
  "properties": {
    "handoff_version": {
      "type": "string",
      "const": "1.0"
    },
    "generated_at": {
      "type": "string"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "embedding_model": {
      "type": "string",
      "minLength": 1
    },
    "dimensions": {
      "type": "integer",
      "minimum": 0,
      "description": "0 if vectors omitted; aegis-local-hash-v1 uses 64; production models often 1536–3072"
    },
    "distance_metric": {
      "type": "string",
      "enum": ["cosine", "dot", "euclidean"]
    },
    "integrity_hash": {
      "type": "string",
      "description": "SHA-256 of all canonical_text values (ordered) joined with newlines and --- separators",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "note": {
      "type": "string"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "canonical_text", "metadata"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "canonical_text": { "type": "string", "minLength": 1 },
          "vector": {
            "type": "array",
            "items": { "type": "number" }
          },
          "dimensions": { "type": "integer", "minimum": 0 },
          "metadata": {
            "type": "object",
            "properties": {
              "source_sections": {
                "type": "array",
                "items": { "type": "string" }
              },
              "priority": { "type": "string" },
              "thread_status": { "type": "string" },
              "never_shed": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "retrieval_hints": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 4
    }
  },
  "additionalProperties": true
}
